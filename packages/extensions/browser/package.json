{
  "name": "chess-browser",
  "version": "0.0.1",
  "private": true,
  "description": "Chess Unlocked - replace Chess.com premium features with free Lichess.org alternatives",
  "scripts": {
    "clean": "rimraf dist .build download",
    "build": "make build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --cache --write .",
    "format:check": "prettier --cache --check .",
    "package": "make package"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.9",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "10.16.0",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rimraf": "6.1.4",
    "typescript": "7.0.2",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2",
    "web-ext": "10.8.0"
  },
  "license": "MIT"
}
