{
  "name": "chess-desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Chess Tournaments - desktop tournament manager",
  "keywords": [
    "chess",
    "tournament",
    "desktop"
  ],
  "homepage": "https://github.com/hieudoanm/chess",
  "bugs": {
    "url": "https://github.com/hieudoanm/chess/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/hieudoanm/chess.git"
  },
  "license": "GPL-3.0-only",
  "author": "hieudoanm <hieumdoan@gmail.com> (https://hieudoanm.github.io)",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "lint": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --cache --write .",
    "test": "jest --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "analyze": "next experimental-analyze",
    "predev": "rimraf .next && kill-port 3000",
    "dev": "next dev --turbopack",
    "prebuild": "rimraf .next out",
    "build": "next build",
    "prestart": "kill-port 3000",
    "start": "next start",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "sql.js": "1.17.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@tauri-apps/cli": "2.12.6",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.16.1",
    "babel-plugin-react-compiler": "1.0.0",
    "daisyui": "5.8.2",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "kill-port": "2.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rimraf": "6.1.4",
    "tailwindcss": "4.3.5",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  }
}
